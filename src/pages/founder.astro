---
import Base from '../layouts/Base.astro';
const credentials = [
 {mark:'AWS', title:'解决方案架构师 · 专业级', detail:'AWS Certified Solutions Architect – Professional · 2020', href:'https://aws.amazon.com/certification/certified-solutions-architect-professional/'},
 {mark:'TOGAF®', title:'企业架构认证', detail:'企业架构方法与治理', href:'https://certification.opengroup.org/'},
 {mark:'PMP®', title:'项目管理专业人士', detail:'Project Management Professional · 2012', href:'https://www.pmi.org/certifications/project-management-pmp'},
 {mark:'CSM®', title:'Certified ScrumMaster', detail:'敏捷协作与迭代交付 · 2017', href:'https://www.scrumalliance.org/get-certified/scrum-master-track/certified-scrummaster'},
];
const projects = [
 ['知识与内容协作','BizTech Navigator','担任技术架构负责人、交付经理，参与内容平台选型、搜索与权限设计，以及基于AWS的云架构建设。'],
 ['企业应用现代化','Contract Insights Platform','开展架构审查与数据库性能分析，提出监控优化、业务逻辑解耦和微服务演进建议。'],
 ['云原生与平台工程','云资源门户与采购协同平台','项目涉及Serverless、容器化、数据湖与消息集成，将业务流程与可扩展的技术平台连接起来。'],
];
---
<Base title="创始人崔驰坤" description="崔驰坤（Richard Chikun Cui），大连坤晟科技有限公司创始人、架构师。吉林大学软件工程专业毕业，曾任职华信、埃森哲，专注企业架构、云原生与工业AI工程落地。">
 <section class="bg-ink text-white py-24 gridlines"><div class="wrap"><p class="text-gold text-xs tracking-[.3em]">FOUNDER / ARCHITECT</p><h1 class="display mt-6">崔驰坤 <span class="text-mint">/ Richard</span></h1><p class="mt-5 text-white/70 text-xl">Richard Chikun Cui · 创始人 / 架构师</p><p class="mt-8 max-w-2xl text-white/60 leading-8">从企业软件到云原生，从架构规划到工业AI应用，让技术方案经得起业务与工程现场的检验。</p></div></section>
 <section class="section"><div class="wrap grid md:grid-cols-[1fr_2fr] gap-12">
 <aside class="bg-[#EAF1EC] rounded-3xl p-8 h-fit"><div class="h-48 rounded-2xl bg-ink text-mint flex items-center justify-center text-7xl font-semibold tracking-tighter" aria-label="Richard Cui姓名首字母图形">RC<span class="text-gold">.</span></div><h2 class="text-2xl font-bold mt-7">崔驰坤</h2><p class="text-jade font-medium mt-2">Richard Chikun Cui</p><p class="text-sm text-ink/60 mt-4">大连坤晟科技有限公司创始人</p><div class="border-t border-ink/10 mt-6 pt-6 text-sm leading-7 text-ink/65"><p>吉林大学 · 软件工程本科</p><p>自2006年起积累企业软件与架构经验</p><p class="mt-4">企业架构 / 云原生 / 工业软件 / AI工程</p></div><a class="btn btn-primary mt-7" href="/contact/">交流与合作 ↗</a></aside>
 <div><p class="eyebrow">PROFILE</p><h2 class="heading mt-4">以架构思维连接<br/>业务问题与技术落地</h2><div class="space-y-6 text-ink/65 leading-9 mt-8"><p>崔驰坤毕业于吉林大学软件工程专业，职业经历覆盖企业软件开发、IT架构规划、跨国企业技术交付与架构人才培养，具有从需求分析、方案设计到工程实施的完整实践经验。</p><p>早期任职大连华信，参与金融保险、企业项目管理等系统的开发与架构设计，随后承担企业IT技术发展工作，推动应用框架、统一身份认证、工作流与系统集成建设。</p><p>2015年加入埃森哲，曾任技术架构交付经理、CIO China Rapid团队技术架构负责人，并承担大中华区技术架构社区负责人角色，参与面向全球业务的知识协作、合同管理、云资源及采购平台建设。</p><p>2023年起开展独立创业实践，持续参与石油钻井智能化、工业监测、装备保障及AI应用相关项目。从业务问题出发，明确系统边界、工程约束和验证标准，推动方案从原型走向实际应用。</p></div></div></div></section>
 <section class="section bg-white"><div class="wrap"><p class="eyebrow">EXPERIENCE</p><h2 class="heading mt-4">从工程实践走向架构与交付</h2><div class="grid md:grid-cols-3 gap-6 mt-10">{[
 ['2006—2015','大连华信 / DHC','企业软件与IT架构','对日软件开发、应用基础框架、企业IT技术发展与系统集成。','https://www.dhcc.com.cn/'],
 ['2015年加入','埃森哲 / Accenture','技术架构与全球交付','曾任技术架构交付经理、CIO Rapid技术架构负责人及大中华区技术架构社区负责人。','https://www.accenture.com/'],
 ['2023年起','坤晟科技 / KunShine','创业与工业AI实践','面向工业场景，结合企业架构、数据与AI技术，推进工程落地。','/about/']
 ].map(([year,name,role,description,href])=><article class="card"><p class="text-sm text-jade">{year}</p><h3 class="text-xl font-bold mt-4"><a href={href}>{name} ↗</a></h3><p class="font-medium mt-5">{role}</p><p class="text-sm leading-7 text-ink/60 mt-3">{description}</p></article>)}</div><p class="text-xs text-ink/50 mt-6">华信、埃森哲为创始人历史任职单位。</p></div></section>
 <section class="section"><div class="wrap"><p class="eyebrow">CREDENTIALS</p><h2 class="heading mt-4">专业积累，有据可循</h2><p class="text-ink/60 leading-8 mt-5">曾获埃森哲高级技术架构师认证，并取得云架构、企业架构、项目管理与敏捷领域的专业认证。</p><div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-10">{credentials.map(c=><a class="card block" href={c.href} target="_blank" rel="noopener noreferrer"><div class="h-28 flex items-center">{c.mark==='AWS' ? <img src="/images/founder/aws-solutions-architect-professional.png" alt="AWS解决方案架构师专业级认证徽章示意" width="112" height="112" loading="lazy" /> : <span class="text-3xl font-bold text-jade">{c.mark}</span>}</div><h3 class="font-bold mt-5">{c.title}</h3><p class="text-sm text-ink/60 leading-6 mt-3">{c.detail}</p><p class="text-xs text-jade mt-5">了解认证体系 ↗</p></a>)}</div><p class="text-xs text-ink/50 leading-6 mt-6">以上为历史取得的认证，未表示当前有效状态。链接指向认证体系介绍；AWS图示来自颁发机构的公开Credly页面，非个人证书验证链接。</p></div></section>
 <section class="section bg-white"><div class="wrap"><p class="eyebrow">SELECTED PRACTICE</p><h2 class="heading mt-4">把复杂需求转化为可交付的系统</h2><div class="grid md:grid-cols-3 gap-6 mt-10">{projects.map(([tag,title,description])=><article class="card"><p class="text-sm text-jade">{tag}</p><h3 class="text-xl font-bold mt-4">{title}</h3><p class="text-ink/60 text-sm leading-7 mt-5">{description}</p></article>)}</div><p class="text-xs text-ink/50 mt-6">上述为创始人在埃森哲任职期间的项目经历。</p><div class="mt-12 border-t border-ink/10 pt-10 grid md:grid-cols-2 gap-8"><div><h3 class="text-2xl font-bold">让架构经验成为团队能力</h3><p class="text-ink/60 leading-8 mt-4">曾参与架构师培训、认证评审与技术社区建设，组织50余场技术与架构分享，并作为外部讲师分享AWS Serverless与云化架构实践。</p></div><div><h3 class="text-2xl font-bold">持续关注的方向</h3><div class="flex flex-wrap gap-3 mt-5">{['企业与软件架构','云原生与应用现代化','石油钻井智能化','工业数字孪生','AI Agent工程','知识工程'].map(t=><span class="rounded-full bg-mint px-4 py-2 text-sm text-jade">{t}</span>)}</div></div></div></div></section>
</Base>
