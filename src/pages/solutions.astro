---
import Base from '../layouts/Base.astro';
const items=[{id:'drilling',title:'石油钻井智能化',sub:'核心业务',desc:'依托双液面、井下复杂、溢流漏失大屏和钻井可视化等持续项目经验，建设实时监测、工况诊断、三维井筒与AI辅助分析能力。',features:['双液面与流体状态监测','溢流漏失风险监测','井下复杂工况诊断','井筒三维可视化与历史复盘']},{id:'equipment',title:'装备保障与智能管理',sub:'行业项目经验',desc:'基于技术勤务管理系统、器材库存运输智能管理系统等项目经验，支持装备全生命周期、库存流转与业务流程协同。',features:['装备台账与状态管理','器材库存与流转','运输与任务协同','运营分析与智能辅助']},{id:'monitoring',title:'工业监测与能源应用',sub:'拓展业务',desc:'结合工商储能、水质检测等项目经验，提供面向工业现场的采集、监测、预警和可视化系统设计与开发。',features:['工业数据采集与集成','实时监控与告警','运行数据分析','系统集成与私有化部署']},{id:'ai',title:'AI架构咨询与FDE',sub:'专业服务',desc:'从业务需求澄清到数据、模型、应用与工程交付，帮助企业识别AI落地场景，建立可验证的技术架构与实施路线。',features:['企业AI应用架构','智能体与知识系统','软件工程与交付自动化','FDE技术咨询与原型验证']}];
---
<Base title="解决方案" description="坤晟科技解决方案涵盖石油钻井智能化、井下复杂诊断、工业监测、装备保障、数字孪生及企业AI架构咨询。"><section class="bg-ink text-white py-24"><div class="wrap"><p class="text-gold text-xs tracking-[.3em]">SOLUTIONS</p><h1 class="display mt-6">让行业经验<br/><span class="text-mint">转化为智能工程能力</span></h1><p class="mt-7 max-w-2xl text-white/65 leading-9">聚焦可落地的工业软件与AI解决方案，以场景为中心、以工程可靠性为底线。</p></div></section><div class="wrap py-20 space-y-8">{items.map((x,i)=><section id={x.id} class="grid md:grid-cols-[1fr_1fr] gap-10 border border-ink/10 rounded-3xl p-8 md:p-12 bg-white"><div><p class="eyebrow">0{i+1} · {x.sub}</p><h2 class="heading mt-4">{x.title}</h2><p class="mt-6 text-ink/65 leading-9">{x.desc}</p><a href="/contact/" class="inline-flex text-jade font-bold mt-7">讨论应用场景 ↗</a></div><div class="bg-paper rounded-2xl p-8"><p class="text-sm font-bold mb-6">核心能力</p><ul class="space-y-5">{x.features.map(f=><li class="flex gap-3 items-center"><span class="text-jade">✦</span>{f}</li>)}</ul></div></section>)}</div></Base>
