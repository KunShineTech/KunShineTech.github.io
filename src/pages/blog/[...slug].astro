---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){const posts=await getCollection('blog',({data})=>!data.draft);return posts.map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;
const {Content}=await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article" published={post.data.pubDate.toISOString()}><article><header class="bg-ink text-white py-20"><div class="wrap max-w-4xl"><a href="/blog/" class="text-mint text-sm">← 返回技术博客</a><p class="text-gold text-xs tracking-widest mt-10">{post.data.tags.join(' / ')}</p><h1 class="text-4xl md:text-5xl font-bold leading-tight mt-5">{post.data.title}</h1><p class="text-white/55 mt-6">{post.data.author} · {post.data.pubDate.toLocaleDateString('zh-CN',{timeZone:'UTC'})}</p></div></header><div class="wrap py-16"><div class="prose mx-auto"><Content/></div></div></article></Base>
