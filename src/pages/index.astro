---
import Base from '../layouts/Base.astro';
const services=[{n:'01',t:'石油钻井智能化',en:'DRILLING INTELLIGENCE',d:'围绕双液面、井下复杂工况、溢流漏失与井筒可视化，构建面向钻井现场的监测、诊断和辅助决策能力。',tag:'核心业务'},{n:'02',t:'装备保障与智能管理',en:'ASSET & OPERATIONS',d:'面向技术勤务、器材库存与运输管理，连接装备、流程、人员和业务数据。',tag:'行业经验'},{n:'03',t:'工业监测与能源应用',en:'INDUSTRIAL MONITORING',d:'结合工商储能、水质检测等项目经验，提供数据采集、状态监控、异常预警与工程软件集成。',tag:'拓展方向'},{n:'04',t:'企业AI架构与FDE',en:'AI ARCHITECTURE & FDE',d:'从业务问题识别、系统架构到AI工程实施，帮助企业构建可验证、可持续演进的智能应用。',tag:'咨询服务'}];
---
<Base title="首页">
<section class="bg-ink text-white relative overflow-hidden"><div class="absolute inset-0 gridlines opacity-50"></div><div class="absolute -right-40 top-[-80px] w-[700px] h-[700px] rounded-full border border-mint/10"></div><div class="absolute -right-20 top-10 w-[560px] h-[560px] rounded-full border border-mint/20"></div><div class="absolute right-10 top-32 w-[380px] h-[380px] rounded-full border border-gold/30"></div><div class="absolute right-36 top-56 w-[150px] h-[150px] rounded-full bg-jade/30 blur-3xl"></div><div class="wrap relative pt-24 pb-28 md:pt-36 md:pb-40"><p class="text-gold text-xs tracking-[.35em] font-semibold mb-7">KUNSHINETECH · INDUSTRIAL INTELLIGENCE</p><h1 class="display max-w-4xl">以东方智慧<br/><span class="text-[#9DD8C8]">构筑工业智能未来</span></h1><p class="mt-9 max-w-2xl text-lg text-white/70 leading-9">从石油钻井工程到工业设备与能源场景，融合行业知识、工程软件、数字孪生与人工智能，让复杂系统更可知、更可靠。</p><div class="mt-10 flex flex-wrap gap-4"><a href="/solutions/" class="btn bg-[#C9A76B] text-ink hover:bg-[#E3C58C]">探索解决方案 <span aria-hidden="true">↗</span></a><a href="/contact/" class="btn border border-white/40 text-white hover:bg-white/10">洽谈合作 →</a></div><div class="mt-20 flex flex-wrap gap-8 text-xs tracking-wider text-white/50"><span>工业数据</span><span>·</span><span>工程模型</span><span>·</span><span>智能诊断</span><span>·</span><span>数字孪生</span></div></div></section>
<section class="section"><div class="wrap"><div class="flex flex-col md:flex-row justify-between gap-8 mb-12"><div><p class="eyebrow">WHAT WE DO</p><h2 class="heading mt-4">深耕行业，构建智能能力</h2></div><p class="max-w-md text-ink/60 leading-8">以真实工业场景为起点，拒绝脱离业务价值的技术堆叠。让软件架构与行业工程知识协同演进。</p></div><div class="grid md:grid-cols-2 gap-5">{services.map(s=><article class="card group"><div class="flex justify-between items-start"><span class="text-jade font-bold">{s.n} / {s.en}</span><span class="text-xs bg-mint px-3 py-1 rounded-full">{s.tag}</span></div><h3 class="text-2xl font-bold mt-10 mb-4">{s.t}</h3><p class="text-ink/60 leading-8">{s.d}</p><a class="inline-block text-jade font-semibold mt-7" href="/solutions/">了解更多 ↗</a></article>)}</div></div></section>
<section class="section bg-[#EAF1EC]"><div class="wrap grid md:grid-cols-2 gap-12 items-center"><div><p class="eyebrow">CORE EXPERTISE</p><h2 class="heading mt-4">让数据、模型与决策<br/>形成闭环</h2><p class="mt-7 text-ink/65 leading-9">以连续的石油钻井项目实践为基础，逐步沉淀实时数据接入、井筒可视化、异常诊断和工程分析能力。坚持以物理模型和领域规则建立可信基础，再引入AI提升分析效率。</p><a class="btn btn-primary mt-8" href="/solutions/">查看钻井解决方案 →</a></div><div class="bg-ink rounded-[28px] p-8 md:p-12 text-white relative overflow-hidden"><div class="absolute inset-0 gridlines opacity-40"></div><div class="relative space-y-4">{['现场数据与实时感知','物理模型与行业规则','异常诊断与趋势预测','三维可视化与辅助决策'].map((x,i)=><div class="flex items-center gap-5 bg-white/10 border border-white/10 rounded-xl px-5 py-5"><span class="text-gold font-bold">0{i+1}</span><span class="font-medium">{x}</span><span class="ml-auto text-mint">↘</span></div>)}</div></div></div></section>
<section class="section"><div class="wrap text-center"><p class="eyebrow">OUR PHILOSOPHY</p><h2 class="heading mt-5">代码服务于工程，智能服务于判断</h2><p class="max-w-3xl mx-auto mt-7 text-ink/60 leading-9">我们相信，真正有价值的工业智能化，不止于展示数据，更在于理解业务、约束风险、支持专业决策，并在真实场景中持续验证。</p><div class="mt-10 flex flex-wrap justify-center gap-4"><a href="/about/" class="btn btn-outline">认识坤晟科技</a><a href="/founder/" class="btn btn-primary">了解创始人</a></div></div></section>
<section class="bg-jade text-white py-20"><div class="wrap flex flex-col md:flex-row justify-between gap-8 items-start md:items-center"><div><p class="text-white/65 text-xs tracking-widest">WORK WITH US</p><h2 class="text-3xl md:text-4xl font-bold mt-4">让下一项工业创新，从一次对话开始。</h2></div><a href="/contact/" class="btn bg-white text-jade">联系坤晟科技 ↗</a></div></section>
</Base>
